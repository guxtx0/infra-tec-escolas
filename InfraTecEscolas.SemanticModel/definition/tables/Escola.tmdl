	partition Escola = m
		mode: import
		source =
				let
				    // Lê o CSV da pasta indicada em PastaDados. Se a pasta não for encontrada,
				    // usa a cópia da amostra guardada dentro do projeto (o relatório avisa na tela).
				    Arquivo =
				        try Binary.Buffer(File.Contents(PastaDados & "dim_escola.csv"))
				        otherwise Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(
				        Arquivo,
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				    {"co_entidade", Int64.Type},
				    {"escola", type text},
				    {"co_municipio", Int64.Type},
				    {"id_rede_atual", Int64.Type},
				    {"primeiro_ano_no_censo", Int64.Type},
				    {"ultimo_ano_no_censo", Int64.Type}
				    }, "en-US"),
				    NomeFormatado = Table.TransformColumns(Tipos, {{"escola", each if _ = null then null else Text.Proper(Text.Trim(_)), type text}}),
				    Renomeadas = Table.RenameColumns(NomeFormatado, {{"co_entidade", "Código INEP"}, {"escola", "Escola"},
				        {"primeiro_ano_no_censo", "Primeiro ano no Censo"}, {"ultimo_ano_no_censo", "Último ano no Censo"}}),
				    SemColunasTecnicas = Table.RemoveColumns(Renomeadas, {"co_municipio", "id_rede_atual"})
				in
				    SemColunasTecnicas

