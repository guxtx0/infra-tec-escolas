	partition 'Município' = m
		mode: import
		source =
				let
				    // Lê o CSV da pasta indicada em PastaDados. Se a pasta não for encontrada,
				    // usa a cópia da amostra guardada dentro do projeto (o relatório avisa na tela).
				    Arquivo =
				        try Binary.Buffer(File.Contents(PastaDados & "dim_municipio.csv"))
				        otherwise Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(
				        Arquivo,
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				    {"co_municipio", Int64.Type},
				    {"municipio", type text},
				    {"mesorregiao", type text},
				    {"microrregiao", type text},
				    {"uf", type text}
				    }, "en-US"),
				    Renomeadas = Table.RenameColumns(Tipos, {{"municipio", "Município"}, {"mesorregiao", "Mesorregião"}, {"microrregiao", "Microrregião"}, {"uf", "UF"}})
				in
				    Renomeadas

