	column 'Porte da escola'
		dataType: string
		lineageTag: f7319a49-c410-5295-96b9-75b8105fdf73
		summarizeBy: none
		sourceColumn: Porte da escola

		annotation SummarizationSetBy = Automatic

	partition 'Fato Infraestrutura' = m
		mode: import
		source =
				let
				    // Lê o CSV da pasta indicada em PastaDados. Se a pasta não for encontrada,
				    // usa a cópia da amostra guardada dentro do projeto (o relatório avisa na tela).
				    Arquivo =
				        try Binary.Buffer(File.Contents(PastaDados & "fato_infraestrutura.csv"))
				        otherwise Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(
				        Arquivo,
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				    {"ano", Int64.Type},
				    {"co_entidade", Int64.Type},
				    {"co_municipio", Int64.Type},
				    {"id_rede", Int64.Type},
				    {"id_localizacao", Int64.Type},
				    {"in_internet", Int64.Type},
				    {"in_banda_larga", Int64.Type},
				    {"in_internet_alunos", Int64.Type},
				    {"in_internet_aprendizagem", Int64.Type},
				    {"in_laboratorio_informatica", Int64.Type},
				    {"in_computador_aluno", Int64.Type},
				    {"in_rede_local", Int64.Type},
				    {"in_rede_sem_fio", Int64.Type},
				    {"qt_desktop_aluno", Int64.Type},
				    {"qt_comp_portatil_aluno", Int64.Type},
				    {"qt_tablet_aluno", Int64.Type},
				    {"qt_computadores_alunos", Int64.Type},
				    {"qt_equip_multimidia", Int64.Type},
				    {"qt_mat_bas", Int64.Type},
				    {"in_ganhou_internet", Int64.Type},
				    {"indice_infra_tec", type number}
				    }, "en-US"),
				    // Coluna derivada no Power Query: porte da escola pelo número de matrículas
				    PorteDaEscola = Table.AddColumn(
				        Tipos,
				        "Porte da escola",
				        each
				            if [qt_mat_bas] = null or [qt_mat_bas] = 0 then "Sem matrícula informada"
				            else if [qt_mat_bas] <= 100 then "1. Até 100 matrículas"
				            else if [qt_mat_bas] <= 500 then "2. De 101 a 500"
				            else if [qt_mat_bas] <= 1000 then "3. De 501 a 1.000"
				            else "4. Mais de 1.000",
				        type text
				    )
				in
				    PorteDaEscola

