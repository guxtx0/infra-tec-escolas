table Rede
	lineageTag: dc766cea-fa41-5ed6-a5b7-5437dd0053c5

	column id_rede
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: 70508cd4-84ce-5429-bb1f-0fc1288ae80a
		summarizeBy: none
