		annotation SummarizationSetBy = Automatic

	column Rede
		dataType: string
		lineageTag: 12d62711-d49e-522c-9b39-aaaf1b150f40
		summarizeBy: none
		sourceColumn: Rede
		sortByColumn: Ordem

