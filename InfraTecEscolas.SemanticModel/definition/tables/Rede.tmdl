	partition Rede = m
		mode: import
		source =
				let
				    // Lê o CSV da pasta indicada em PastaDados. Se a pasta não for encontrada,
				    // usa a cópia da amostra guardada dentro do projeto (o relatório avisa na tela).
				    Arquivo =
				        try Binary.Buffer(File.Contents(PastaDados & "dim_rede.csv"))
				        otherwise Binary.Decompress(Binary.FromText("y0yJL0pNSdUBE+lFpQX5EH5+UUpqLpjJZazjW5qXmZxZkJijE3B4V1JOZnKijiGXkY5rcUliSimyqBGXoY4bUE8RsqAxl4lOQFFmWWJKIpw24QIA", BinaryEncoding.Base64), Compression.Deflate),
				    Fonte = Csv.Document(
				        Arquivo,
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				    {"id_rede", Int64.Type},
				    {"rede", type text},
				    {"grupo_rede", type text},
				    {"ordem_rede", Int64.Type}
				    }, "en-US"),
				    Renomeadas = Table.RenameColumns(Tipos, {{"rede", "Rede"}, {"grupo_rede", "Grupo de rede"}, {"ordem_rede", "Ordem"}})
				in
				    Renomeadas

