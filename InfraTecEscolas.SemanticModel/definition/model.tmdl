model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados", "Fato Infraestrutura", "Ano", "Rede", "Localização", "Município", "Escola", "Metadados", "Medidas"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table 'Fato Infraestrutura'
ref table Ano
ref table Rede
ref table 'Localização'
ref table 'Município'
ref table Escola
ref table Metadados
ref table Medidas

ref cultureInfo pt-BR

