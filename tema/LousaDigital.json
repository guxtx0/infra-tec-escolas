{
  "name": "Lousa Digital",
  "dataColors": [
    "#2A9D8F",
    "#3D5A80",
    "#E9C46A",
    "#E76F51",
    "#8AB17D",
    "#98C1D9",
    "#6D597A",
    "#F4A261"
  ],
  "background": "#FFFFFF",
  "foreground": "#1D2939",
  "tableAccent": "#2A9D8F",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#1D3557",
  "center": "#98C1D9",
  "minimum": "#E0F2F1",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D3557"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D2939"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D2939"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#667085"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E7EC"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1D2939"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FB"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FB"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": true,
            "markerSize": 5
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1D3557"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "backColorAlternate": {
              "solid": {
                "color": "#F2F7F7"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1D3557"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1D2939"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#1D2939"
              }
            },
            "textSize": 10
          }
        ]
      }
    }
  }
}